# Copy to .env.local and fill in. The database and its tables (demo_requests for the Book Demo pop-up,
# contact_enquiries for the /contact form) are created automatically on the first enquiry.
# XAMPP defaults: user root, empty password.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=techcadd

# Any long random string; signs the "a + b = ?" security question.
CAPTCHA_SECRET=
